+# The leanprover/comparator harness (PAComparator/<Result>/{Challenge,Solution}.lean). Named
+# `PAComparator`, not `Comparator`: the required LeanGallery package has its own `Comparator` lib
+# (`Comparator.Goodstein.*`, `Comparator.Hydra.*`) and Lake would resolve our imports into it. Deliberately
+# NOT in defaultTargets and NOT reachable from the main roots: the Challenge carries `sorry` by
+# design and the main libs build warnings-as-errors, so this must stay out of the default build.
+# The package sets `srcDir = "src"`, but the harness lives at repo root under `PAComparator/` (matching
+# tao-collatz / lean-gallery layout), so this lib overrides `srcDir = "."`. Build explicitly with
+# `lake build PAComparator`; the real gate is `.github/workflows/comparator.yml`.
+[[lean_lib]]
+name = "PAComparator"
+srcDir = ".."
+globs = ["PAComparator.+"]
+
 # Machine-verified blueprint status gate. Computes each `@[goodstein_blueprint]` node's real
 # `collectAxioms` footprint and reconciles it against the category claim. `supportInterpreter`
 # lets `importModules` run imported modules' initializers (registering env extensions) at runtime,
@@ -41,3 +54,11 @@ rev = "2040d2f33807c34636b8a9f20189d22b48d65040"
 name = "checkdecls"
 git = "https://github.com/PatrickMassot/checkdecls.git"
 rev = "3d425859e73fcfbef85b9638c2a91708ef4a22d4"
+
+# The Kirby–Paris hydra (gallery `Hydra` / `Chop` / `Step` + the canonical battle), for the
+# stage-2 independence result.  Only `LeanGallery.Logic.Hydra.*` is imported; the gallery's own
+# mathlib pin is overridden by this repo's (Foundation's), and the hydra files compile on both.
+[[require]]
+name = "LeanGallery"
+git = "https://github.com/gotrevor/lean-gallery.git"
+rev = "a834bbad2f36eedcc16066b2bc4da49f98ab5b85"
